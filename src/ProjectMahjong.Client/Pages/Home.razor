@page "/"
@page "/join/{InviteCode}"
@inject RoomApiClient Api
@inject SessionStorage Sessions
@inject NavigationManager Navigation

<PageTitle>福州麻将</PageTitle>

<main class="home-shell">
    <section class="hero-card">
        <p class="eyebrow">四人在线牌桌</p>
        <h1>福州麻将</h1>
        <p class="lead">开个房间，叫上亲友，马上开牌。</p>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert" role="alert">@_error</div>
        }

        <label for="display-name">你的名字</label>
        <input id="display-name" maxlength="8" autocomplete="nickname"
               placeholder="例如：陈阿姨" @bind="_displayName" />

        @if (string.IsNullOrWhiteSpace(InviteCode))
        {
            <button class="button primary large" disabled="@_busy" @onclick="CreateRoomAsync">
                @(_busy ? "正在创建…" : "创建房间")
            </button>
            <div class="divider"><span>或者加入房间</span></div>
            <label for="room-code">六位房间号</label>
            <input id="room-code" class="room-code-input" maxlength="6" autocomplete="off"
                   inputmode="numeric" pattern="[0-9]*" placeholder="例如：381026" @bind="_roomCode" />
            <button class="button secondary large" disabled="@_busy" @onclick="JoinRoomAsync">加入房间</button>
        }
        else
        {
            <div class="invite-box">房间号：<strong>@InviteCode.ToUpperInvariant()</strong></div>
            <button class="button primary large" disabled="@_busy" @onclick="JoinInvitedRoomAsync">
                @(_busy ? "正在加入…" : "加入这个房间")
            </button>
            <a class="text-link" href="/">返回首页</a>
        }

        @if (_lastSession is not null && string.IsNullOrWhiteSpace(InviteCode))
        {
            <button class="resume-button" @onclick="ResumeLastRoom">回到房间 @_lastSession.RoomCode</button>
        }

        <a class="rules-link" href="/rules">查看本游戏采用的规则</a>
    </section>
</main>

@code {
    [Parameter] public string? InviteCode { get; set; }

    private string _displayName = string.Empty;
    private string _roomCode = string.Empty;
    private string? _error;
    private bool _busy;
    private PlayerSessionDto? _lastSession;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _lastSession = await Sessions.LoadLastAsync();
        if (_lastSession is not null) _displayName = _lastSession.DisplayName;
        StateHasChanged();
    }

    private Task CreateRoomAsync() => RunAsync(() => Api.CreateRoomAsync(_displayName));
    private Task JoinRoomAsync() => RunAsync(() => Api.JoinRoomAsync(_roomCode, _displayName));
    private Task JoinInvitedRoomAsync() => RunAsync(() => Api.JoinRoomAsync(InviteCode!, _displayName));

    private async Task RunAsync(Func<Task<ApiCallResult<SessionResponseDto>>> request)
    {
        if (string.IsNullOrWhiteSpace(_displayName))
        {
            _error = "请先输入你的名字。";
            return;
        }

        _busy = true;
        _error = null;
        var result = await request();
        _busy = false;

        if (!result.Succeeded)
        {
            _error = result.Error;
            return;
        }

        await Sessions.SaveAsync(result.Value!.Session);
        Navigation.NavigateTo($"/room/{result.Value.Session.RoomCode}");
    }

    private void ResumeLastRoom() => Navigation.NavigateTo($"/room/{_lastSession!.RoomCode}");
}
