@using System.Globalization

<article class="player-panel position-@Position">
    <header class="player-identity">
        <span class="avatar @(IsCurrentTurn ? "current-turn" : string.Empty) @(IsDisconnected ? "disconnected" : string.Empty)"
              title="@(IsDisconnected ? "玩家掉线，AI 暂时接管" : Player.DisplayName)">@NameInitial</span>
        <span class="identity-text">
            <strong class="player-name @(IsDealer ? "dealer" : string.Empty) @(IsDisconnected ? "disconnected" : string.Empty)">
                @Player.DisplayName
                @if (IsDealer)
                {
                    <span class="dealer-badge" title="庄位" aria-hidden="true">
                        <svg viewBox="0 0 24 24" width="16" height="16" focusable="false" aria-hidden="true">
                            <path d="M12 2l2.9 5.9L21 9l-4.5 3.6L17.8 20 12 16.9 6.2 20l1.3-7.4L3 9l6.1-1.1L12 2z" fill="#ffd859" stroke="#b07e00" stroke-width="0.5" />
                        </svg>
                    </span>
                }
            </strong>
            <small>@GameUi.SeatName(Player.Seat) · @Player.Score 分</small>
            @if (IsDisconnected)
            {
                <em>AI 接管</em>
            }
            else if (Player.IsBot)
            {
                <em>电脑</em>
            }
        </span>
    </header>

    @if (IsLocalPlayer)
    {
        <div class="own-hand-area">
            <div class="own-hand-heading">
                <span>双击出牌</span>
                @if (MyGoldCount > 0)
                {
                    <strong class="gold-count">金 × @MyGoldCount</strong>
                }
            </div>
            <div class="hand" aria-label="我的手牌">
                @foreach (var tile in MyHand.Where(tile => tile.Id != DrawnTileId))
                {
                    <MahjongTile Tile="tile" IsGold="@IsGold(tile)" Selected="@(SelectedTileId == tile.Id)"
                                 Disabled="@HandDisabled" OnClick="OnTileSelected" OnDoubleClick="OnTileDoubleClick" />
                }
                @if (DrawnTile is { } drawnTile)
                {
                    <div class="drawn-tile" aria-label="刚摸进的牌">
                        <MahjongTile Tile="drawnTile" IsGold="@IsGold(drawnTile)" Selected="@(SelectedTileId == drawnTile.Id)"
                                     Disabled="@HandDisabled" OnClick="OnTileSelected" OnDoubleClick="OnTileDoubleClick" />
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <div class="concealed-count" aria-label="@Player.ConcealedTileCount 张手牌">
            <span class="tile-back" aria-hidden="true"></span><strong>×@Player.ConcealedTileCount</strong>
        </div>
    }

    <div class="public-tiles">
        @if (Player.Flowers.Count > 0)
        {
            <div class="public-group" aria-label="花牌"><span class="group-label">花</span><TileGroup Tiles="Player.Flowers" GoldTile="GoldTile" GroupBonusTiles="true" /></div>
        }
        @foreach (var meld in Player.Melds)
        {
            <div class="public-group" aria-label="@GameUi.MeldName(meld.Kind)"><span class="group-label">@GameUi.MeldName(meld.Kind)</span><TileGroup Tiles="meld.Tiles" GoldTile="GoldTile" /></div>
        }
        @if (Player.Discards.Count > 0)
        {
            <div class="public-group discard-river" aria-label="@Player.DisplayName 的弃牌"><TileGroup Tiles="Player.Discards" GoldTile="GoldTile" /></div>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired] public SeatSnapshotDto Player { get; set; } = default!;
    [Parameter] public Guid CurrentPlayerId { get; set; }
    [Parameter] public bool IsCurrentTurn { get; set; }
    [Parameter] public bool IsDealer { get; set; }
    [Parameter, EditorRequired] public string Position { get; set; } = string.Empty;
    [Parameter, EditorRequired] public IReadOnlyList<TileDto> MyHand { get; set; } = [];
    [Parameter] public int? DrawnTileId { get; set; }
    [Parameter] public TileDto? GoldTile { get; set; }
    [Parameter] public int? SelectedTileId { get; set; }
    [Parameter] public bool CanDiscard { get; set; }
    [Parameter] public bool CommandPending { get; set; }
    [Parameter] public EventCallback<TileDto> OnTileSelected { get; set; }
    [Parameter] public EventCallback<TileDto> OnTileDoubleClick { get; set; }

    private bool IsLocalPlayer => Player.PlayerId == CurrentPlayerId;
    private bool IsDisconnected => !Player.IsBot && !Player.IsConnected;
    private bool HandDisabled => !CanDiscard || CommandPending;
    private int MyGoldCount => MyHand.Count(IsGold);
    private string NameInitial => StringInfo.GetNextTextElement(Player.DisplayName.Trim());
    private TileDto? DrawnTile => DrawnTileId is int id ? MyHand.FirstOrDefault(tile => tile.Id == id) : null;
    private bool IsGold(TileDto tile) => GameUi.IsGold(tile, GoldTile);
}
