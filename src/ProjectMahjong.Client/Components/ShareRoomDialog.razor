@inject NavigationManager Navigation
@inject IJSRuntime JavaScript

@if (Open)
{
    <div class="dialog-backdrop" role="presentation" @onclick="OnClose">
        <section class="share-dialog" role="dialog" aria-modal="true" aria-labelledby="share-title" @onclick:stopPropagation="true">
            <button class="close-button" aria-label="关闭" @onclick="OnClose">×</button>
            <p class="eyebrow">邀请亲友</p>
            <h2 id="share-title">分享房间</h2>
            <span class="room-code-label">六位房间号</span>
            <strong class="room-code">@RoomCode</strong>
            <label for="invite-link">邀请链接</label>
            <input id="invite-link" value="@InviteUrl" readonly />
            <button class="button primary" @onclick="CopyAsync">@(_copied ? "已复制" : "复制邀请链接")</button>
        </section>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter, EditorRequired] public string RoomCode { get; set; } = string.Empty;
    [Parameter] public EventCallback OnClose { get; set; }

    private bool _copied;
    private string InviteUrl => Navigation.ToAbsoluteUri($"/join/{RoomCode}").ToString();

    protected override void OnParametersSet()
    {
        if (!Open) _copied = false;
    }

    private async Task CopyAsync()
    {
        await JavaScript.InvokeVoidAsync("navigator.clipboard.writeText", InviteUrl);
        _copied = true;
    }
}
